# Copy this file to .env and replace the sample values with your real credentials.
PORT=3000
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="Your Salon Name <your_gmail@gmail.com>"
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# IMPORTANT: this must be your Twilio WhatsApp sender number, usually from the sandbox
# Example: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TARGET_EMAIL=your_target_email@example.com
# International format without spaces, e.g. +2349022790025
TARGET_WHATSAPP=+2349022790025
